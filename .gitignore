# =====================================================================
# Gerenciador de Projetos — o que NUNCA entra no Git
# Regra: Git guarda código, scripts e documentação técnica.
# Dados reais, dados pessoais, horas, segredos e builds ficam fora.
# Conferir antes de cada commit: npm run scan:secrets
# =====================================================================

# --- Dependências e builds ---
node_modules/
app/
dist/
out/
release/
*.lnk
selftest.json

# --- DADOS (reais, PII, horas, auditoria) ---
data/
local-data/
backups/
exports/
projects.json
projects.json.*
audit.log
audit.log.*
*.log
*.gphours
*.gpexport
*.gpbackup
*.gpupdate
*.gpconfig
atualizacoes/
*.corrompido-*
# planilhas e exports pessoais (fixtures de teste continuam versionadas)
*.xlsx
*.xls
*.csv
!test/fixtures/**

# --- Segredos ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.dpapi
*.dpapi.json
secrets/
signing/

# --- Ferramentas locais ---
.claude/settings.local.json
.vscode/
.idea/
*.tmp
*.bak
Thumbs.db
desktop.ini
.DS_Store
